{
  "name": "saas-mcp-connector",
  "version": "0.1.0",
  "description": "Reference MCP server exposing a SaaS API to Claude and other MCP clients, with per-user scoping, read-only mode and rate limits.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsc && vitest run",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js http"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "bin": {
    "saas-mcp-connector": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  }
}
